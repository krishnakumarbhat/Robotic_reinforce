# Raspberry Pi optimized Dockerfile for ROS2 SLAM application
FROM arm64v8/ubuntu:22.04 as base

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies optimized for Raspberry Pi
RUN apt-get update && apt-get install -y \
    curl \
    gnupg2 \
    lsb-release \
    software-properties-common \
    python3-pip \
    python3-dev \
    build-essential \
    cmake \
    git \
    wget \
    vim \
    nano \
    libssl-dev \
    libusb-1.0-0-dev \
    pkg-config \
    libgtk-3-dev \
    libglib2.0-dev \
    libcanberra-gtk3-module \
    && rm -rf /var/lib/apt/lists/*

# Add ROS2 repository
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg
RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null

# Install ROS2 Humble (minimal for Raspberry Pi)
RUN apt-get update && apt-get install -y \
    ros-humble-ros-base \
    ros-humble-rtabmap-ros \
    ros-humble-realsense2-camera \
    ros-humble-realsense2-description \
    ros-humble-rviz2 \
    ros-humble-nav2-bringup \
    python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies with ARM64 optimizations
RUN pip3 install --no-cache-dir \
    pyrealsense2 \
    opencv-python-headless \
    numpy \
    open3d

# Create workspace directory
WORKDIR /workspace

# Copy application files
COPY . /workspace/

# Source ROS2 in bashrc
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc
RUN echo "source /workspace/install/setup.bash" >> ~/.bashrc

# Build the workspace with reduced parallelism for Raspberry Pi
RUN . /opt/ros/humble/setup.sh && \
    colcon build --symlink-install --parallel-workers 2

# Create entrypoint script
RUN echo '#!/bin/bash\n\
source /opt/ros/humble/setup.bash\n\
source /workspace/install/setup.bash\n\
exec "$@"' > /entrypoint.sh && \
    chmod +x /entrypoint.sh

# Optimize for Raspberry Pi
ENV ROS_DOMAIN_ID=0
ENV PYTHONPATH=/workspace/install/lib/python3.10/site-packages:$PYTHONPATH

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "/workspace/scripts/main.py"] 