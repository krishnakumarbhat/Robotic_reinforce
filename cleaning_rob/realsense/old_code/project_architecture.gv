
digraph SLAM_Robot_Orchestrator {
    bgcolor="#2e3440";
    node [style=filled, shape=box, fontname="Helvetica", fontsize=10, color="#d8dee9", fillcolor="#4c566a"];
    edge [fontname="Helvetica", fontsize=9, color="#d8dee9"];
    graph [label="SLAM Robot Orchestrator (spo) Architecture", fontname="Helvetica", fontsize=14, fontcolor="#eceff4", labelloc=t];

    subgraph cluster_host {
        label="Host System";
        style="rounded";
        color="#88c0d0";
        fontcolor="#eceff4";
        
        user [label="User", shape=circle, fillcolor="#81a1c1"];
        docker_compose [label="docker-compose up", shape=invhouse, fillcolor="#b48ead"];
        realsense_cam [label="RealSense Camera", shape=cylinder, fillcolor="#a3be8c"];
        
        user -> docker_compose [label="runs"];
    }

    subgraph cluster_docker {
        label="Docker Container";
        style="rounded";
        color="#88c0d0";
        fontcolor="#eceff4";

        subgraph cluster_scripts {
            label="Orchestration Scripts";
            style="rounded,dashed";
            color="#ebcb8b";
            fontcolor="#eceff4";
            
            main_py [label="scripts/main.py
(Entrypoint)"];
            slam_manager_py [label="scripts/slam_manager.py"];
            analysis_manager_py [label="scripts/analysis_manager.py"];
        }

        subgraph cluster_ros {
            label="ROS 2 Nodes";
            style="rounded,dashed";
            color="#ebcb8b";
            fontcolor="#eceff4";

            slam_launch [label="launch/slam_launch.py"];
            realsense_node [label="realsense2_camera_node"];
            rtabmap_node [label="rtabmap_ros::rtabmap"];
            rviz_node [label="rviz2 (Optional GUI)"];
        }
        
        map_db [label="rtabmap.db
(Map Data)", shape=cylinder, fillcolor="#a3be8c"];

        docker_compose -> main_py [label="starts"];
        main_py -> slam_manager_py [label="selects SLAM"];
        slam_manager_py -> slam_launch [label="executes"];
        
        slam_launch -> realsense_node [label="starts"];
        slam_launch -> rtabmap_node [label="starts"];
        slam_launch -> rviz_node [label="starts"];
        
        realsense_node -> rtabmap_node [label="RGB/Depth Images", style=dotted, arrowhead=open];
        rtabmap_node -> rviz_node [label="Map/Pose Data", style=dotted, arrowhead=open];
        rtabmap_node -> map_db [label="saves/loads"];
    }
    
    realsense_cam -> realsense_node [label="provides data via USB", lhead=cluster_docker];
}
