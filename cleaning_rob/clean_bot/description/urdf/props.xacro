<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- general -->
    <xacro:property name="half_pi" value="1.570796" />

    <!-- joint limits -->
    <xacro:property name="shoulder_pan_joint_min" value="-2.05" />
    <xacro:property name="shoulder_pan_joint_max" value="2.05" />
    <xacro:property name="shoulder_lift_joint_min" value="-2.125" />
    <xacro:property name="shoulder_lift_joint_max" value="2.08" />
    <xacro:property name="elbow_joint_min" value="-2.14" />
    <xacro:property name="elbow_joint_max" value="2.14" />
    <xacro:property name="wrist_yaw_joint_min" value="-2.1" />
    <xacro:property name="wrist_yaw_joint_max" value="2.05" />
    <xacro:property name="wrist_pitch_joint_min" value="-2.05" />
    <xacro:property name="wrist_pitch_joint_max" value="2.05" />
    <xacro:property name="wrist_roll_joint_min" value="-2.0" />
    <xacro:property name="wrist_roll_joint_max" value="1.75" />
    <xacro:property name="gripper_jaw_joint_min" value="-0.69" />
    <xacro:property name="gripper_jaw_joint_max" value="0.973" />
    <!-- hardware max seems to be 0.9, although 1.28 is achievable in URDF -->

    <!-- hardware limits -->
    <xacro:property name="effort" value="3.92266" />
    <!-- <xacro:property name="effort" value="12" /> -->
    <xacro:property name="velocity" value="8.9" />
</robot>