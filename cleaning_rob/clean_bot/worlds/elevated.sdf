<?xml version="1.0"?>
<sdf version="1.8">
  <world name="plain">
    <physics name="default" type="ode">
      <max_step_size>0.05</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <include>
      <uri>model://Sun</uri>
    </include>
    <include>
      <uri>model://Ground Plane</uri>
    </include>
