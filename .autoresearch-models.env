# .autoresearch-models.env — USER-OWNED model pins (frozen driver + directive read this; agents never edit logic)
# Verified 2026-09-19: relay-exact probe PASS (rc=0, 16s, 7 crisp bullets) on seat 1.
# Slug source of truth = opencode.json (user config). Never invent slugs.
# Worker model intentionally UNPINNED: default session model is proven.

# Brain relay: seat 1 = muse-spark (opencode-responses path), seat 2 = DeepSeek fallback.
# Fast-fail timeouts so a dead seat never stalls an iteration.
AUTORESEARCH_BRAIN_LIST="opencode-responses/muse-spark-1.3-contributor-free openrouter/deepseek/deepseek-v4-flash-0731:free"
AUTORESEARCH_BRAIN_TIMEOUTS="180 180"

# Safety floor: never pause the loop for pool size (applies if a worker list is ever set).
AUTORESEARCH_MIN_WORKERS=1
AUTORESEARCH_MAX_CONCURRENT=4

# Worker pool (2026-09-27: +space-bunny-free slot 2 (unlimited while alive; rotation
# auto-skips it when 500ing) + muse-spark-1.3 ABSOLUTE LAST (director-grade fallback
# when every free seat is gone). Order = rotation order.
AUTORESEARCH_WORKER_LIST="opencode-responses/muse-spark-1.3-contributor-free openrouter/thinkingmachines/inkling:free opencode/space-bunny-free opencode/mimo-v2.6-flash-free openrouter/deepseek/deepseek-v4-flash-0731:free openrouter/thinkingmachines/inkling-small:free openrouter/nex-agi/nex-n2.5-mini:free openrouter/poolside/laguna-s-2.1:free openrouter/cohere/north-mini-code:free openrouter/inclusionai/ling-3.0-flash-sante:free opencode/ling-3.0-flash-fin-free opencode/big-pickle google/gemini-3.5-flash-lite google/gemini-3.8-flash google/gemini-3.5-flash"

# Local validation interpreter contract (verified 2026-09-18 smoke test):
# ALWAYS python3.10 with panda-gym APPENDED to existing PYTHONPATH (replacing it drops
# /media/pope/projecteo/python_libs_gpu/site-packages and breaks gymnasium/torch imports):
#   PYTHONPATH="<repo>/panda-gym:$PYTHONPATH" python3.10 <script>
